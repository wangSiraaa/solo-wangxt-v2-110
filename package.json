{
  "name": "url-migration-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "栏目改版旧链接迁移验证工作台 (Fastify + PostgreSQL + Vue 3)",
  "scripts": {
    "db:init": "node scripts/init-db.js",
    "seed": "node scripts/seed.js",
    "server": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "preview": "node scripts/init-db.js && node scripts/seed.js && node server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "vite": "^5.4.2",
    "vue": "^3.4.38"
  }
}
